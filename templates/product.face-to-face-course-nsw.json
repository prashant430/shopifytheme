    "image_with_text_MWQEg8": {
      "type": "image-with-text",
      "blocks": {
        "heading_QKJNVf": {
          "type": "heading",
          "settings": {
            "heading": "Meet our NSW Trainer",
            "heading_size": "h1"
          }
        },
        "text_b4eVp4": {
          "type": "text",
          "settings": {
            "text": "<p>Test & Tag Courses in NSW are run by our very own Doug Steen.</p><p>Doug has been testing and tagging for over a decade and has huge experience in teaching others to do so. Doug consistently receives 5-star reviews from our students that praise his ability to teach in a manner that is easy-to-understand and provides plenty of 1-on-1 attention to each student.</p><p>Doug has an expert knowledge of test and tag regulations and best practices for testing and tagging in NSW.</p>",
            "text_style": "body"
          }
        },
