      "settings": {
        "custom_liquid": "<div class=\"page-width\">\n<!-- TrustBox widget - Carousel -->\n<div class=\"trustpilot-widget\" data-locale=\"en-AU\" data-template-id=\"53aa8912dec7e10d38f59f36\" data-businessunit-id=\"56bab5e20000ff000588b9fa\" data-style-height=\"140px\" data-style-width=\"100%\" data-stars=\"4,5\" data-review-languages=\"en\">\n  <a href=\"https://au.trustpilot.com/review/testandtagtraining.com.au\" target=\"_blank\" rel=\"noopener\">Trustpilot</a>\n</div>\n<!-- End TrustBox widget -->\n</div>",
