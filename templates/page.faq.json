    "collapsible_content_6Hm3Aq": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_FbD6mr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "If I have a group of people that need training, can we receive a discount?",
            "icon": "none",
            "row_content": "<p>If you have more than five people that need training, we can in fact, offer a group discount. </p><p>Please call 1300 848 302 if you would like to discuss training options.</p>",
            "page": ""
          }
        },
        "collapsible_row_nTd3wQ": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can you conduct a course at my workplace?",
            "icon": "none",
            "row_content": "<p>Yes, we certainly can! We have provided onsite test and tag training for some of the largest companies in Australia and have worked with hundreds of smaller businesses in a wide variety of industries. </p><p>If you would like to discuss how we can put together a tailored training option for your company, please <a href=\"/pages/contact\" title=\"Contact\">contact us</a>.</p>",
            "page": ""
          }
        },
        "collapsible_row_ViMmEM": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is there a minimum number of participants required for on-site training?",
            "icon": "none",
            "row_content": "<p>For onsite training, a minimum of 6 and a maximum of 12 participants are required.</p>",
            "page": ""
          }
        }
      },
