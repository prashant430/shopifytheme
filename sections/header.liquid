      options[i].text = options[i].text.replace('Face-to-Face Test & Tag Course - ', '');
    }
  
  $(document).on('change', 'select.main_product_select', function() {
    console.log($(this).val());

    if( $(this).val() == "/products/face-to-face-test-tag-course" ){
      $(this).parent('.hero_course_form_field').next('.hero_course_form_field').show();
      return ;
    }
    
    if ($(this).val() != "/products/test-tag-training-courses-face-to-face"){
      $(this).parent('.hero_course_form_field').next('.hero_course_form_field').hide();
      var url = $(this).val();
      if (url) {
          window.location.href = url;
      }
    }else{
      $(this).parent('.hero_course_form_field').next('.hero_course_form_field').show();
    }
  });  
  
  $(document).on('change', 'select.child_pages', function() {
