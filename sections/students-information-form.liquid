                onchange="fillHidden('Terms-and Conditions')"
                value="I have read and agree to the cancellation and refund policy"

              ><label for="I-have read and agree to the cancellation and refund policy"
                >I have read and agree to the <a href="/pages/refund-cancellations-policy">cancellation and refund policy</a></label
                                                                                                          
              ><br>
              <input
                required
                class="required"
                type="checkbox"
                id="I-have read the terms and conditions"
                hidden-data="Terms-and Conditions"
                onchange="fillHidden('Terms-and Conditions')"
                value="I have read the terms and conditions"

              ><label for="I-have read the terms and conditions"
                >I have read the <a href="/pages/student-information">terms and conditions</a></label
              ><br>
              <input type="hidden" id="Terms-and Conditions" name="contact[Terms and Conditions]">
              <script>
                function fillHidden(hiddenname) {
                var checkboxes = document.querySelectorAll('[hidden-data="'+hiddenname+'"]');
                var hiddenfield = document.getElementById(hiddenname);
                hiddenfield.value = ""
                var i;
                for (i = 0; i < checkboxes.length; i++) {
                  var x = checkboxes[i];
                  if(x.checked){
                    if(hiddenfield.value==""){
                      hiddenfield.value = x.value;
                      }else{
                      hiddenfield.value = hiddenfield.value + ", " + x.value;
                      }
                    }
                  }
                }
              </script>
            </div>
          </div>
